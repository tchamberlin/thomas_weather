/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "weather",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-10",
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"not_found_handling": "none",
		"run_worker_first": true
	},
	"triggers": {
		"crons": [
			"*/15 * * * *"
		]
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"kv_namespaces": [
		{
			"binding": "WEATHER",
			"id": "2f1afba1ef434b54ad79c54d2e8f6c85"
		}
	],
	"vars": {
		// How often the cron refreshes neighbor stations, in 15-minute cron ticks
		// (4 => hourly). Primary stations refresh every tick.
		"NEIGHBOR_REFRESH_EVERY_N_TICKS": "4"
	}
	/**
   * Secrets (set via `npx wrangler secret put <NAME>`):
   *   WU_API_KEY       — Weather Underground API key. Reachable ONLY by the cron
   *                      and token-authorized admin endpoints; the request path
   *                      is KV-only by construction (see WuClient in src/index.ts).
	   *   WU_STATION_IDS   — Comma-separated PWS station IDs
   *   BACKFILL_TOKEN   — bearer/query token for admin history backfill endpoints
   */
}
